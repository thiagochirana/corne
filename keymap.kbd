// =============================================================================
//  Layout do Corne 3x6+3
// =============================================================================
//
//  Cada camada começa com [nome] e tem 42 teclas: 3 linhas de 12 e, por fim,
//  os 6 polegares. A quebra de linha é só visual; o que importa é a ordem.
//  Comentários começam com //.
//
//  Teclas e ações disponíveis:
//    A..Z  0..9  F1..F12  ENT ESC BSPC TAB SPC DEL INS HOME END PGUP PGDN
//    LEFT DOWN UP RGHT  - = [ ] \ ; ' ` , . /  CAPS PSCR MUTE VOLU VOLD APP
//    ! @ # $ % ^ & * ( ) UNDS + { } | : " ~ < > ?   (símbolos com shift)
//    CTRL SHIFT ALT WIN                         modificadores da esquerda
//    RIGHT_CTRL RIGHT_SHIFT ALTGR RIGHT_WIN     modificadores da direita
//    (os nomes curtos do QMK, LCTL LSFT LALT LGUI RALT..., também valem)
//    ___  transparente (usa a camada de baixo)     XXX  nada
//    MO(camada)  segura = camada ativa             TG(camada) liga/desliga
//    TO(camada)  vai para a camada                 DF(camada) troca a base
//    LT(camada, TECLA)  toque = tecla, segura = camada (aceita ? ! etc.)
//    MT(SHIFT, TECLA) ou SHIFT_T(TECLA)  toque = tecla, segura = modificador
//    CTRL(X) SHIFT(X) ALT(X) WIN(X) ALTGR(X)  atalho, ex.: CTRL(SHIFT(TAB))
//    RGB_TOG RGB_MOD RGB_RMOD RGB_HUI RGB_HUD RGB_SAI RGB_SAD RGB_VAI RGB_VAD
//    RGB_SPI RGB_SPD RGB_THEME   OLED_TOG OLED_NEXT OLED_PREV   BOOT REBOOT
//
//  Camadas podem ser referenciadas pelo nome, ex.: MO(numbers).
//  MACRO(nome) toca uma macro do macros.kbd, ex.: MACRO(assinatura).
//
//  Layout do sistema (Windows/Linux): o teclado manda posições de tecla e o
//  sistema escolhe o caractere. Diga aqui qual layout está configurado lá:
//    abnt2    Português (Brasil ABNT2)
//    us-intl  Inglês (EUA, internacional), ç = AltGr + vírgula
//    us       Inglês (EUA), sem acentos
//  Com abnt2 ou us-intl, escreva o caractere que quer e o firmware acha a
//  tecla certa:  ç Ç ´ ` ~ ^ ¨  (ou CCED ACUT GRAVE TILD CIRC DIAE).
//  Acentos são teclas mortas: ´ e depois A = á;  ~ e depois A = ã.
//  Símbolos ([ ] / ; \ ' etc.) também são traduzidos para o layout escolhido.
//  Nomes de tecla (SCLN, LBRC, QUOT...) são posições fixas, sem tradução.

host = abnt2

[base]
ESC     Q    W    E    R      T                  Y    U    I    O    P    ´
SHIFT   A    S    D    F      G                  H    J    K    L    Ç    ~
CTRL    Z    X    C    V      B                  N    M    ,    .    /    LT(setup, ?)
          ALTGR DEL LT(num, ENT)        LT(sym, SPC) BSPC WIN

[num]
'       1    2    3    4    5          6    7    8    9    0    -
SHIFT   [    ]    {    }    XXX        LEFT DOWN UP   RGHT =    +
CTRL    |    XXX  (    )    XXX        HOME PGDN PGUP END  XXX  TO(base)
             TAB  TO(sym)   ENT        SPC MO(setup) WIN

[sym]
ESC     !    @    #    $    %          ^    &    *    (    )    BSPC
SHIFT   XXX  XXX  XXX  XXX  XXX        -    =    [    ]    \    `
CTRL    XXX  XXX  XXX  XXX  XXX       UNDS  +    {    }    |    TO(base)
                 XXX  XXX  ENT        SPC ___     WIN

[setup]
BOOT     XXX     XXX     XXX     XXX     XXX         XXX  XXX  XXX  XXX  XXX  BOOT
RGB_TOG  RGB_HUI RGB_SAI RGB_VAI RGB_SPI RGB_MOD     OLED_NEXT XXX XXX XXX XXX XXX
RGB_THEME RGB_HUD RGB_SAD RGB_VAD RGB_SPD RGB_RMOD   OLED_PREV OLED_TOG XXX XXX XXX TO(base)
                                      ___ ___ ___        ___ ___ ___
